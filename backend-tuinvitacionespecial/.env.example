# Servidor API
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# Base de Datos (PostgreSQL 18.7)
POSTGRES_USER=tuinvitacion
POSTGRES_PASSWORD=tuinvitacion_dev_password
POSTGRES_DB=tuinvitacionespecial
DATABASE_URL=postgresql://tuinvitacion:tuinvitacion_dev_password@localhost:5432/tuinvitacionespecial

# Redis 8.0 (BullMQ y Pub/Sub)
REDIS_URL=redis://localhost:6379

# Seguridad y Administración (completar en fases siguientes)
MASTER_API_KEY=replace_with_64_hex_chars
GOOGLE_CLIENT_ID=replace_with_google_oauth_client_id

# Correo Transaccional (Resend)
RESEND_API_KEY=re_replace_with_resend_key
RESEND_FROM_EMAIL=invitaciones@tudominio.cl
